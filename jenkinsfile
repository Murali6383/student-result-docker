pipeline {

    agent any

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: ['development', 'staging', 'production'],
            description: 'Select deployment environment'
        )

        string(
            name: 'HOST_PORT',
            defaultValue: '5000',
            description: 'Host port for application'
        )
    }

    environment {
        IMAGE_NAME = 'student-result'
        CONTAINER_NAME = 'student-result-app'
        CONTAINER_PORT = '5000'
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Murali6383/student-result-docker.git'
            }
        }

        stage('Build Information') {
            steps {
                echo "================================"
                echo "Jenkins Build Number: ${BUILD_NUMBER}"
                echo "Environment: ${params.ENVIRONMENT}"
                echo "Host Port: ${params.HOST_PORT}"
                echo "Docker Tag: build-${BUILD_NUMBER}"
                echo "================================"
            }
        }

        stage('Install Dependencies') {
            steps {
                bat 'npm install'
            }
        }

        stage('Test') {
            steps {
                bat 'npm run test --if-present'
            }
        }

        stage('Build') {
            steps {
                bat 'npm run build --if-present'
            }
        }

        stage('Docker Build') {
            steps {
                bat "docker build -t %IMAGE_NAME%:build-${BUILD_NUMBER} ."
            }
        }

        stage('Stop Old Container') {
            steps {
                bat '''
                docker stop %CONTAINER_NAME% || exit /b 0
                docker rm %CONTAINER_NAME% || exit /b 0
                '''
            }
        }

        stage('Deploy') {
            steps {
                bat """
                docker run -d ^
                --name %CONTAINER_NAME% ^
                -p ${params.HOST_PORT}:%CONTAINER_PORT% ^
                %IMAGE_NAME%:build-${BUILD_NUMBER}
                """
            }
        }

        stage('Health Check') {
            steps {
                bat 'docker ps'
                bat "curl http://localhost:${params.HOST_PORT}"
            }
        }
    }

    post {

        success {
            echo "================================"
            echo "CI/CD PIPELINE SUCCESS"
            echo "Build Number : ${BUILD_NUMBER}"
            echo "Environment  : ${params.ENVIRONMENT}"
            echo "Docker Image : ${IMAGE_NAME}:build-${BUILD_NUMBER}"
            echo "Application  : http://localhost:${params.HOST_PORT}"
            echo "================================"
        }

        failure {
            echo "================================"
            echo "CI/CD PIPELINE FAILED"
            echo "Build Number : ${BUILD_NUMBER}"
            echo "================================"
        }
    }
}
